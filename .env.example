# Copy to .env.local and fill in. Never commit real values.
# Validated by lib/env.ts. In production the server refuses to start without the REQUIRED ones.

# Origin only (no /v2). This app is served under /v2 until it lives in its own repo.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics (all optional)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
META_CAPI_TOKEN=
META_GRAPH_VERSION=

# Cloudflare Turnstile (REQUIRED in production; skipped in development)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Supabase (REQUIRED in production, server only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI engines (server only; at least one REQUIRED in production). Model names are optional overrides.
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
OPENAI_MODEL=
GEMINI_MODEL=
PERPLEXITY_MODEL=

# SMS OTP (MSG91, DLT registered). KEY and TEMPLATE are REQUIRED in production.
# In development without these, the code is printed to the server console.
OTP_PROVIDER_KEY=
OTP_SENDER_ID=
OTP_DLT_TEMPLATE_ID=

# Lead + result webhook (see README "Webhook payload")
WEBHOOK_URL=

# Secret salt for hashing IPs and OTPs (REQUIRED in production, 16+ characters).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=

# Footer + legal pages
NEXT_PUBLIC_CONTACT_EMAIL=
# WhatsApp click-to-chat (digits only, with country code)
NEXT_PUBLIC_WHATSAPP_NUMBER=
